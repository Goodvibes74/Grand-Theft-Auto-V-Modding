*.reg
*.mp3
*.jpg
*.pdf

# ==========================================
# System, IDE, and Log Files
# ==========================================
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db

# IDE specific (Visual Studio, VS Code, JetBrains)
/.vs/
/.vscode/
/*.suo
/*.user
/*.sln
bin/
obj/


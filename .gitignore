# ==========================================
# GTA V Base Game Files (Ignore Large Binaries)
# ==========================================
*.rpf
*.exe
*.dll
*.idx
*.dat
*.bin
common.rpf
x64*.rpf

# Ignore main game folders
/update/
/x64/
/ReadMe/
/Redistributables/

# ==========================================
# Common Modding Frameworks & Engines
# ==========================================
# Script Hook V & Community Script Hook V .NET
ScriptHookV.dll
ScriptHookVDotNet.dll
ScriptHookVDotNet.ini
ScriptHookVDotNet.log
ScriptHookVDotNet2.dll
ScriptHookVDotNet3.dll
dinput8.dll

# OpenIV & LML (Lennart's Mod Loader)
# /Mods/ RPFs are ignored by *.rpf; tracked via Mods/MANIFEST.md instead
/lml/
vfs.log
OpenIV.log

# FiveM / Alt:V Cache & Server Binaries (If applicable)
# Uncomment these if you are developing for multiplayer platforms
# /cache/
# /alpine/
# *.chk

# ==========================================
# RAGE Engine Assets (3D Models, Textures, Audio)
# ==========================================
# Only untrack these if you aren't using Git LFS
*.ytd
*.ydr
*.yft
*.ymt
*.ypt
*.ycd
*.awc
#New additions
*.reg
*.mp3
*.jpg
*.pdf

# ==========================================
# System, IDE, and Log Files
# ==========================================
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db

# IDE specific (Visual Studio, VS Code, JetBrains)
.vs/
/.vscode/
/*.suo
*.user
/*.sln
bin/
obj/

# ==========================================
# Whitelist (Files we ALWAYS want to track)
# ==========================================
!*.ini
!*.lua
!*.cs
!*.json
!*.xml
!*.txt
!*.md

# ==========================================
# Mod binaries we DO track (see MOD_TRACKING.md)
# ==========================================
# SHVDN mods
!scripts/*.dll
# Script hook layer
!/ScriptHookV.dll
!/ScriptHookVDotNet2.dll
!/ScriptHookVDotNet3.dll
!/dinput8.dll
!/xinput1_4.dll
# RDE hook libraries (loaded by RDE's ASI plugins)
!/EasyHook64.dll
!/EasyHookPatch.dll
# Small mod assets
!menyooStuff/*.mp3


# ApiDocGen downloads (NuGet packages, natives.json)
ModDevelopment/tools/ApiDocGen/cache/

# Downloaded mod archives (other authors, large). Our patched copies live in ModDevelopment/MyMods/.
GTA ONLINE MODS/
1cfcd8-CodeWalker30_dev46/

# Mods turned off by tools/mod-profile.ps1
*.disabled
*.story

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Generates the API reference in ModDevelopment/docs/reference/ from the game's DLLs.
    Not a game script: tools/Directory.Build.props stops the shared script settings from applying here.
    Run: dotnet run -c Release (from ModDevelopment/tools/ApiDocGen)
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
    <!-- .NET Framework 4.8 reference assemblies, used when the Windows targeting pack isn't installed (Linux, macOS). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Net48ReferencePath</_Parameter1>
      <_Parameter2>$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)/build/.NETFramework/v4.8</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
